node_modules/
dist/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example
# Bases de datos locales, en cualquier paquete (el patrón anclado a la raíz
# no cubría apps/api/data/, ni los ficheros -wal/-shm de SQLite).
**/data/*.sqlite
**/data/*.sqlite-*
# CODEX_HOME por usuario: contiene credenciales gestionadas por el CLI de
# Codex. Anclado con **/ igual que las bases: el patrón a secas no cubría
# apps/api/data/codex/, y un `git add -A` habría commiteado tokens.
**/data/codex/
playwright-report/
test-results/

# Trazas de misiones: salida generada, pesada y reproducible (pnpm mission).
apps/missions/traces/

# El baul del deposito de sprites hace un respaldo antes de reescribir: es
# estado de runtime, no contenido. El `sprites.json` SI se versiona — son once
# dibujos que costaron consultas de verdad.
ii/apps/sprites/datos/*.viejos
