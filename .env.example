# Copiá este archivo a `.env` (que no se versiona) y ajustá lo que necesites.
#
# De fábrica no hace falta tocar NADA: Ánima arranca sin prestar ninguna cuenta,
# y quien quiera mente real enchufa su propia API OpenAI-compatible desde el
# navegador (⚙ ajustes). Esa llave no pasa por el servidor.

# ─── LA CANILLA (ADR 0089) ─────────────────────────────────────────────────
#
# ¿Se pueden usar los CLI instalados en la máquina que corre esto (Codex,
# Claude)? En 1, el que entre piensa con TU cuenta — el CLI corre del lado del
# servidor, así que el que paga sos vos y el que decide es cualquiera que tenga
# la URL. Dejalo en 0 salvo que esto corra en tu máquina y para vos.
ANIMA_CLI_LOCAL=0

# El `~/.codex` de esta máquina: la carpeta que dejó `codex login`, con
# `auth.json` adentro. **Solo hace algo con ANIMA_CLI_LOCAL=1.** Comentada, se
# monta una carpeta vacía del repo, así que el contenedor ni siquiera tiene tus
# credenciales adentro. Cuando la apuntás, se monta de SOLO LECTURA y el
# contenedor se hace una copia propia: nada de lo que pase adentro toca esta
# carpeta.
#   Windows:  ANIMA_CODEX_SEED=C:/Users/TU_USUARIO/.codex
#   macOS/Linux: ANIMA_CODEX_SEED=/home/TU_USUARIO/.codex
#ANIMA_CODEX_SEED=C:/Users/TU_USUARIO/.codex

# ─── Lo demás ──────────────────────────────────────────────────────────────

# Puerto de la máquina. Cambialo si 8787 ya lo usa otro proyecto.
ANIMA_PORT=8787

# A qué interfaz se asoma. 0.0.0.0 = visible desde la red local (para que
# entren desde otros dispositivos); 127.0.0.1 = solo esta máquina.
ANIMA_BIND=0.0.0.0

# Cuánto razona el modelo en cada consulta. Más alto piensa mejor y gasta más
# cuota. minimal | low | medium | high | xhigh. Solo con ANIMA_CLI_LOCAL=1.
ANIMA_CODEX_EFFORT=low

# Modelo de Codex. Vacío = el «Automático» de la cuenta, que es lo recomendado.
# Solo con ANIMA_CLI_LOCAL=1.
ANIMA_CODEX_MODEL=
